# Servidor
PORT=5000
NODE_ENV=development

# Base de Datos MongoDB
# IMPORTANTE: Reemplaza <db_password> con tu contraseña real de MongoDB Atlas.
# NO subas tu contraseña real a repositorios públicos.
MONGO_URI=mongodb+srv://WilliansV86:<db_password>@cluster0.adlajpr.mongodb.net/Cluster0?retryWrites=true&w=majority&appName=Cluster0

# Admin
# Define una clave secreta y compleja para proteger las rutas de administración.
# Esta clave debe ser la misma que se usa en el frontend para acceder a las funciones de admin.
ADMIN_KEY=YOUR_SECRET_ADMIN_KEY_PLACEHOLDER

# Email de Administrador para recibir notificaciones de compras
ADMIN_EMAIL=tucorreo@ejemplo.com

# Configuración de Correo Electrónico
# Ejemplo para Gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=tucuenta@gmail.com
EMAIL_PASSWORD=tu_contraseña_o_app_password
EMAIL_FROM=tucuenta@gmail.com
EMAIL_FROM_NAME=Sorteo Venezolano

# NOTA: Si usas Gmail, debes crear una "contraseña de aplicación" en tu cuenta de Google
# Ve a https://myaccount.google.com/security y crea una contraseña de aplicación

# Cloudinary (para subir comprobantes de pago)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Otros
# JWT_SECRET=your_jwt_secret_key # Si se implementa autenticación JWT para usuarios
# JWT_EXPIRES_IN=30d
